## Global Docker ignore for root build context (Next.js frontend)

# VCS / CI / OS noise
.git
.github
.gitignore
.gitattributes
.DS_Store

# Editors/IDE
.idea
.vscode
*.iml

# Next.js project
my-app/node_modules
my-app/.next
my-app/.turbo
my-app/.vercel
my-app/coverage

# Build artifacts
my-app/out
my-app/dist

# Logs
*.log
npm-debug.log*

# Env/secrets at repo root
.env
*.env
*.pem
*.key
*.crt
*.p12
*.jks

# Keep nginx/ for Dockerfile / deploy
# Keep my-app/package-lock.json for reproducible npm ci

# Local env files for Next.js app
my-app/.env*
